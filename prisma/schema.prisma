// Prisma schema for Integral Revenue Management
// Production datasource is Postgres (Neon, same as Integral Valet).
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// role:   "SUPER_ADMIN" | "ADMIN" | "GARAGE_MANAGER" | "EMPLOYEE"
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("EMPLOYEE")
  createdAt    DateTime @default(now())
  garageId String?
  garage   Garage? @relation(fields: [garageId], references: [id])
  reportEmail String?
  adminGarages AdminGarage[]
  shiftReports   ShiftReport[] @relation("SubmittedBy")
  ncVouchers     NCVoucher[]
  checkedInTickets  Ticket[]   @relation("CheckedInBy")
  checkedOutTickets Ticket[]   @relation("CheckedOutBy")
  couponBooksSold   CouponPack[] @relation("SoldBy")
}
model AdminGarage {
  id      String @id @default(cuid())
  adminId String
  admin   User   @relation(fields: [adminId], references: [id])
  garageId String
  garage   Garage @relation(fields: [garageId], references: [id])
  createdAt DateTime @default(now())
  @@unique([adminId, garageId])
}
model Garage {
  id        String   @id @default(cuid())
  name      String
  address   String?
  hourlyRate Float?  @default(0)
  logoUrl    String?
  createdAt  DateTime @default(now())
  users          User[]
  adminGarages   AdminGarage[]
  shiftReports   ShiftReport[]
  tickets        Ticket[]
  rateTiers      RateTier[]
  paymentMethods GaragePaymentMethod[]
  shiftTemplates ShiftTemplate[]
  ncVouchers     NCVoucher[]
  couponBooks    CouponBook[]
}
model NCVoucher {
  id             String    @id @default(cuid())
  code           String    @unique
  garageId       String
  garage         Garage    @relation(fields: [garageId], references: [id])
  status         String    @default("ACTIVE")
  note           String?
  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id])
  usedByTicketId String?
  usedAt         DateTime?
  voucherPhotoUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ── COUPON SYSTEM ─────────────────────────────────────────────────────────────

// CouponBook: a template defining a type of coupon pack that can be sold.
// Admin creates these per garage. e.g. "10-pack · 2 free hours · $50"
model CouponBook {
  id          String   @id @default(cuid())
  garageId    String
  garage      Garage   @relation(fields: [garageId], references: [id])
  name        String   // e.g. "Standard 10-Pack"
  description String?
  // Pack size: 5 | 10 | 15 | 20
  packSize    Int
  // Discount type: "FLAT_DOLLAR" | "FREE_HOURS" | "FIXED_RATE"
  discountType String
  // Value depends on discountType:
  // FLAT_DOLLAR  → dollars off (e.g. 5.00 = $5 off)
  // FREE_HOURS   → hours free (e.g. 2.0 = first 2 hours free)
  // FIXED_RATE   → flat fee charged (e.g. 3.00 = pay only $3)
  discountValue Float
  // Price charged to the customer for the entire pack
  salePrice    Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  packs        CouponPack[]
}

// CouponPack: a purchased pack of coupons sold to a specific customer.
// Created when a sale is processed via Square Terminal.
model CouponPack {
  id           String     @id @default(cuid())
  couponBookId String
  couponBook   CouponBook @relation(fields: [couponBookId], references: [id])
  // Customer info
  customerName  String?
  customerEmail String?
  customerPhone String?
  // Payment info
  amountPaid    Float
  squarePaymentId String?
  // Who sold it and when
  soldById      String
  soldBy        User       @relation("SoldBy", fields: [soldById], references: [id])
  soldAt        DateTime   @default(now())
  // Status: ACTIVE | EXHAUSTED | CANCELLED
  status        String     @default("ACTIVE")
  coupons       Coupon[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// Coupon: individual coupon within a pack, each with its own unique QR code.
model Coupon {
  id           String     @id @default(cuid())
  couponPackId String
  couponPack   CouponPack @relation(fields: [couponPackId], references: [id])
  // Unique token encoded in the QR code — unguessable
  qrToken      String     @unique @default(cuid())
  // Sequential number within the pack (1, 2, 3...)
  sequenceNum  Int
  // Status: UNUSED | USED | CANCELLED
  status       String     @default("UNUSED")
  // Usage tracking
  usedAt          DateTime?
  usedByTicketId  String?
  couponPhotoUrl  String?   // photo staff takes at checkout
  discountApplied Float?    // actual discount amount applied
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ── END COUPON SYSTEM ─────────────────────────────────────────────────────────

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
model ShiftTemplate {
  id        String   @id @default(cuid())
  garageId  String
  garage    Garage   @relation(fields: [garageId], references: [id])
  name      String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
}
model GaragePaymentMethod {
  id        String   @id @default(cuid())
  garageId  String
  garage    Garage   @relation(fields: [garageId], references: [id])
  method    String
  createdAt DateTime @default(now())
  @@unique([garageId, method])
}
model RateTier {
  id       String @id @default(cuid())
  garageId String
  garage   Garage @relation(fields: [garageId], references: [id])
  label String?
  maxHours Float?
  fee      Float
  createdAt DateTime @default(now())
}
model ShiftReport {
  id       String @id @default(cuid())
  garageId String
  garage   Garage @relation(fields: [garageId], references: [id])
  employeeId String
  employee   User   @relation("SubmittedBy", fields: [employeeId], references: [id])
  shiftDate String
  startTime String?
  endTime   String?
  cashRevenue       Float @default(0)
  creditCardRevenue Float @default(0)
  couponRevenue     Float @default(0)
  chargeBackRevenue Float @default(0)
  ncRevenue         Float @default(0)
  loanerRevenue     Float @default(0)
  otherRevenue      Float @default(0)
  otherDescription  String?
  adjustments       Float @default(0)
  adjustmentsNote    String?
  grossTotal Float @default(0)
  netTotal   Float @default(0)
  notes String?
  status      String    @default("DRAFT")
  submittedAt DateTime?
  tickets Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Ticket {
  id           String @id @default(cuid())
  garageId     String
  garage       Garage @relation(fields: [garageId], references: [id])
  ticketNumber String
  qrToken      String @unique
  status String @default("PARKED")
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  apartmentNumber String?
  vehicleMake     String?
  vehicleModel    String?
  vehicleColor    String?
  licensePlate    String?
  parkingLocation String?
  photoUrl        String?
  damagePhotoUrl  String?
  damageTypes     String?
  durationMinutes Int?
  feeAmount       Float?
  paymentMethod   String?
  paymentNote     String?
  checkedInById  String
  checkedInBy    User   @relation("CheckedInBy", fields: [checkedInById], references: [id])
  checkedOutById String?
  checkedOutBy   User?  @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  shiftReportId String?
  shiftReport   ShiftReport? @relation(fields: [shiftReportId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([garageId, ticketNumber])
}
